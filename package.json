      "minecraft-protocol": "github:PrismarineJS/node-minecraft-protocol#master",
      "react": "^18.2.0",
      "prismarine-chunk": "github:zardoy/prismarine-chunk#master",
      "prismarine-item": "latest"
    },
    "updateConfig": {
