      "minecraft-protocol": "patches/minecraft-protocol.patch"
    },
    "ignoredBuiltDependencies": [
      "canvas",
      "core-js",
      "gl"
    ],
    "onlyBuiltDependencies": [
      "sharp",
      "cypress",
      "esbuild",
      "fsevents"
